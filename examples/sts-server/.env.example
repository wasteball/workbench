PORT=8787
ALLOWED_ORIGINS=chrome-extension://replace-with-extension-id
WORKBENCH_STS_TOKEN=replace-with-a-long-random-value

ALIYUN_ACCESS_KEY_ID=replace-with-server-side-ram-user-key
ALIYUN_ACCESS_KEY_SECRET=replace-with-server-side-ram-user-secret
ALIYUN_ROLE_ARN=acs:ram::1234567890123456:role/workbench-upload

OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=replace-with-bucket
