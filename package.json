{
  "name": "workbench-browser-extension",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "A local-first Markdown and file workbench for Chrome.",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "icons": "node scripts/generate-icons.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "docs:check": "node scripts/check-markdown-links.mjs",
    "scan:release": "node scripts/release-scan.mjs",
    "build": "npm run check && wxt build",
    "build:chrome": "npm run check && wxt build -b chrome",
    "zip:chrome": "wxt zip -b chrome",
    "check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:sts",
    "test:unit": "vitest run",
    "test:sts": "node --test examples/sts-server/server.node-test.mjs",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/search": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@uiw/react-codemirror": "4.25.11",
    "ali-oss": "6.23.0",
    "clsx": "2.1.1",
    "dexie": "4.4.4",
    "diff": "8.0.2",
    "docx": "9.7.1",
    "dompurify": "3.4.12",
    "katex": "0.18.1",
    "lucide-react": "1.28.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "11.16.0",
    "nanoid": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/ali-oss": "6.23.3",
    "@types/mdast": "4.0.4",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.4",
    "globals": "17.8.0",
    "jsdom": "27.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wxt": "0.21.3"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
